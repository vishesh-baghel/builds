# The deploy prefixes every variable with TALLY_, so one account can host several builds
# without them reading each other's keys. Unprefixed names also work locally. Prefixed wins.

# Drex, Nace.AI's decision model, through the TypeSafe SDK (wire compatible).
# Only `pnpm run` needs it. The hosted page replays the committed run and makes no calls.
TALLY_TYPESAFE_API_KEY=
TALLY_TYPESAFE_BASE_URL=https://drex.nace.ai
TALLY_TYPESAFE_DEFAULT_MODEL=drex-latest

# Hard ceiling on input tokens per run. Defaults to 30,000,000.
TALLY_TOKEN_CAP=
