# What a CLI deploy may upload. Secrets and build output never leave the machine; each build's
# Vercel project builds from source with its Root Directory set.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
node_modules
**/node_modules
**/.next
**/*.tsbuildinfo
.claude
.git
# the reels' render output, never committed but present in a local clone; no build reads it
reels/out
