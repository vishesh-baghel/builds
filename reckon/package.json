{
  "name": "@builds/reckon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "score": "tsx --env-file=.env.local scripts/score.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "dependencies": {
    "@builds/shared": "workspace:*",
    "@tursodatabase/serverless": "^1.4.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
