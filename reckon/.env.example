# Judgment. The scorecard refuses to run without it; the tests never read it and the sandbox
# falls back to the committed run artifact when it is absent.
TYPESAFE_API_KEY=

# Persistence for the spend counter and the idempotency store on the deploy. Absent is a
# supported state: the cap falls back to a per-instance counter with the committed run
# artifact behind it, which is the same path a fresh clone runs on.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# There is deliberately no mail variable here, and no destination of any kind. This build
# has no send path to configure.
