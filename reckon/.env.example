# The deploy prefixes every variable with RECKON_, so one account can host several builds
# without them reading each other's keys. Unprefixed names also work locally, which is what
# the TypeSafe SDK and the other projects on this machine already use. Prefixed wins.

# Judgment. The scorecard refuses to run without it, and the sandbox's "write your own" tab
# says so plainly rather than pretending. The committed 72 need no key at all.
RECKON_TYPESAFE_API_KEY=

# Persistence for the spend counter and the idempotency store. Absent is a supported state:
# both fall back to per-instance implementations and the page says which mode it is in. That
# is also the path a fresh clone and every `pnpm dev` exercises, so it cannot rot unnoticed.
RECKON_TURSO_DATABASE_URL=
RECKON_TURSO_AUTH_TOKEN=

# Monthly ceiling in cents for everything the sandbox buys. Defaults to 2500.
RECKON_CAP_CENTS=

# There is deliberately no mail variable here, and no destination of any kind. This build has
# no send path to configure.
